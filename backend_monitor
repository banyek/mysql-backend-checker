#!/usr/bin/env python3

import configparser
import logging
import os
import socket
import threading
import time
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

import pymysql


POLL_INTERVAL = 1
DB_TIMEOUT = 2
HEALTH_MAX_AGE = 5
REQUEST_DEADLINE = 2
MAX_REQUESTS = 16


class Health:
    def __init__(self):
        self._healthy_since = None
        self._lock = threading.Lock()

    def update(self, writable):
        with self._lock:
            self._healthy_since = time.monotonic() if writable else None

    def is_healthy(self):
        with self._lock:
            return (
                self._healthy_since is not None
                and time.monotonic() - self._healthy_since < HEALTH_MAX_AGE
            )


class DBCheck(threading.Thread):
    def __init__(self, mysql_config, health, stop):
        super().__init__(name="mysql-poller", daemon=True)
        self.mysql_config = mysql_config
        self.health = health
        self.stop = stop

    def poll(self):
        try:
            with pymysql.connect(
                **self.mysql_config,
                connect_timeout=DB_TIMEOUT,
                read_timeout=DB_TIMEOUT,
                write_timeout=DB_TIMEOUT,
            ) as connection:
                with connection.cursor() as cursor:
                    cursor.execute("SHOW VARIABLES LIKE 'read_only'")
                    row = cursor.fetchone()
            self.health.update(row is not None and row[1] == "OFF")
        except (pymysql.MySQLError, OSError) as exc:
            self.health.update(False)
            logging.warning("MySQL health check failed (%s)", type(exc).__name__)

    def run(self):
        while not self.stop.is_set():
            self.poll()
            self.stop.wait(POLL_INTERVAL)


class HttpHandler(BaseHTTPRequestHandler):
    def do_GET(self):
        self.send_response(200 if self.server.health.is_healthy() else 503)
        self.send_header("Content-Length", "0")
        self.end_headers()

    def log_message(self, format, *args):
        logging.debug("%s %s", self.client_address[0], format % args)


class HealthServer(ThreadingHTTPServer):
    def __init__(self, address, health):
        self.health = health
        self._slots = threading.BoundedSemaphore(MAX_REQUESTS)
        super().__init__(address, HttpHandler)

    def process_request(self, request, client_address):
        if not self._slots.acquire(blocking=False):
            self.shutdown_request(request)
            return
        try:
            super().process_request(request, client_address)
        except BaseException:
            self._slots.release()
            raise

    @staticmethod
    def interrupt_request(request):
        try:
            request.shutdown(socket.SHUT_RDWR)
        except OSError:
            pass

    def process_request_thread(self, request, client_address):
        deadline = threading.Timer(REQUEST_DEADLINE, self.interrupt_request, args=(request,))
        try:
            deadline.start()
            super().process_request_thread(request, client_address)
        finally:
            deadline.cancel()
            self._slots.release()


def read_config(path):
    config = configparser.ConfigParser(interpolation=None)
    with open(path, encoding="utf-8") as source:
        config.read_file(source)
    http = config["http"]
    port = http.getint("port")
    if not 1 <= port <= 65535:
        raise ValueError("[http] port must be between 1 and 65535")
    mysql = config["mysql"]
    return (http.get("bind_address", "127.0.0.1"), port), {
        "host": mysql["mysql_host"],
        "user": mysql["mysql_user"],
        "password": mysql["mysql_password"],
        "database": mysql["mysql_database"] or None,
        "unix_socket": mysql.get("mysql_socket") or None,
    }


def main():
    logging.basicConfig(level=logging.INFO, format="%(asctime)s %(levelname)s %(message)s")
    path = os.getenv("BACKEND_CHECKERCFG", "/usr/local/bin/backend_monitor.cfg")
    health = Health()
    stop = threading.Event()
    try:
        address, mysql_config = read_config(path)
        server = HealthServer(address, health)
    except configparser.Error as exc:
        logging.error("Invalid configuration in %s (%s)", path, type(exc).__name__)
        return 1
    except (OSError, ValueError, KeyError) as exc:
        logging.error("Cannot start backend monitor: %s", exc)
        return 1

    with server:
        DBCheck(mysql_config, health, stop).start()
        logging.info("Health endpoint listening on %s:%s", *server.server_address)
        try:
            server.serve_forever()
        except KeyboardInterrupt:
            pass
        finally:
            stop.set()
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
